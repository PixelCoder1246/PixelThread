PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# JWT
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP — Gmail with App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="PixelThread <your_email@gmail.com>"

# Frontend URL (for email links)
CLIENT_URL=http://localhost:3000

# NVIDIA NIM API (AI Module)
# Get a free API key at https://build.nvidia.com (sign up → "Get API Key")
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct