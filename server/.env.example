PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://user:password@localhost:5432/pixelthread_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/pixelthread_db?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_pass
EMAIL_FROM="PixelThread <noreply@pixelthread.dev>"

# Frontend URL (for email links)
CLIENT_URL=http://localhost:5173